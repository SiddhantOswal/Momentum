# Node 22: copy to .env, then node --env-file=.env index.mjs.
# This starts without mock data or paid cloud integrations.
PORT=4173
USTAAD_ENABLE_DEMO_MODE=false
USTAAD_ENABLE_FIREBASE_AUTH=false
USTAAD_ENABLE_LIVE_MODEL_CALLS=false
USTAAD_ENABLE_RISK_PREDICTION=false
USTAAD_ENABLE_HISTORICAL_EVIDENCE=false
USTAAD_ENABLE_IMPACT_SUMMARY=false
USTAAD_ENABLE_BIGQUERY_WRITES=false
USTAAD_ENABLE_JOB_STORAGE=false
USTAAD_ENABLE_FEEDBACK_WRITES=false
USTAAD_ENABLE_FIRESTORE_GEMINI_CAP=false
USTAAD_ENABLE_APPROVED_PHOTO_CLASSIFICATION=false
# No tokens, service-account keys or session-signing keys belong in this file.
